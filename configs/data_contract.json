{
  "contract_version": "1.0.0",
  "description": "Multimodal session contract for EEG, optical, IMU, and metadata.",
  "modalities": {
    "eeg": {
      "required_columns": [
        "session_id",
        "timestamp_utc",
        "eeg_tp9",
        "eeg_af7",
        "eeg_af8",
        "eeg_tp10",
        "eeg_aux"
      ],
      "timestamp_column": "timestamp_utc",
      "units": {
        "timestamp_utc": "ISO-8601 UTC",
        "eeg_tp9": "microvolts",
        "eeg_af7": "microvolts",
        "eeg_af8": "microvolts",
        "eeg_tp10": "microvolts",
        "eeg_aux": "microvolts"
      },
      "sampling_hz_assumption": 256,
      "max_missing_ratio": 0.2,
      "fallback_behavior": "If EEG missing ratio exceeds threshold, reject session for model training and live inference update."
    },
    "optical": {
      "required_columns": [
        "session_id",
        "timestamp_utc",
        "optics_lo_nir",
        "optics_ro_nir",
        "optics_lo_ir",
        "optics_ro_ir",
        "optics_lo_red",
        "optics_ro_red",
        "optics_lo_amb",
        "optics_ro_amb"
      ],
      "timestamp_column": "timestamp_utc",
      "units": {
        "timestamp_utc": "ISO-8601 UTC",
        "optics_lo_nir": "a.u.",
        "optics_ro_nir": "a.u.",
        "optics_lo_ir": "a.u.",
        "optics_ro_ir": "a.u.",
        "optics_lo_red": "a.u.",
        "optics_ro_red": "a.u.",
        "optics_lo_amb": "a.u.",
        "optics_ro_amb": "a.u."
      },
      "sampling_hz_assumption": 64,
      "max_missing_ratio": 0.35,
      "fallback_behavior": "If optical missing ratio exceeds threshold, keep session but down-weight optical features in fusion."
    },
    "imu": {
      "required_columns": [
        "session_id",
        "timestamp_utc",
        "acc_x",
        "acc_y",
        "acc_z",
        "gyro_x",
        "gyro_y",
        "gyro_z"
      ],
      "timestamp_column": "timestamp_utc",
      "units": {
        "timestamp_utc": "ISO-8601 UTC",
        "acc_x": "g",
        "acc_y": "g",
        "acc_z": "g",
        "gyro_x": "deg/s",
        "gyro_y": "deg/s",
        "gyro_z": "deg/s"
      },
      "sampling_hz_assumption": 52,
      "max_missing_ratio": 0.25,
      "fallback_behavior": "If IMU missing ratio exceeds threshold, disable motion gating and mark confidence degraded."
    }
  },
  "metadata": {
    "required_fields": [
      "session_id",
      "task_type",
      "start_timestamp_utc",
      "end_timestamp_utc",
      "subjective_fatigue_score",
      "reaction_time_ms",
      "accuracy"
    ],
    "allowed_task_types": [
      "baseline_rest",
      "sustained_attention",
      "n_back",
      "code_comprehension"
    ],
    "fatigue_score_range": [
      0,
      10
    ]
  },
  "missing_value_policy": {
    "global": "No nulls in timestamps. Null sensor values allowed only within modality threshold.",
    "fallback_priority": [
      "eeg",
      "optical",
      "imu"
    ]
  }
}
